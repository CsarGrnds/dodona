# Optional. Without it, Dodona runs in rules-only mode (no AI thesis).
ANTHROPIC_API_KEY=
# Model used by the per-ticker agent.
ANTHROPIC_MODEL=claude-sonnet-5-5
# GitHub token used by agents to push to CsarGrnds/dodona. Never commit the real value.
GITHUB_TOKEN=
# Optional. SEC EDGAR (8-K filings + reported earnings on the ticker page) asks for your name and email,
# e.g. "Jane Doe jane@example.com". Same value the trader skills read as sec_user_agent.
SEC_USER_AGENT=
# Optional. IBKR Client Portal Gateway for the "Refresh from IBKR" button (read-only). It runs on this
# machine; Dodona only accepts a localhost URL. Default https://localhost:5001 (macOS uses 5000 for AirPlay).
IBKR_GATEWAY_URL=
# Optional. Which account to read when your login has several; the first one otherwise.
IBKR_ACCOUNT=
# Optional. Where the gateway is installed, for the /ibkr-gateway skill (default ~/clientportal.gw).
IBKR_GATEWAY_DIR=
